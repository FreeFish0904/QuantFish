# QuantFish environment variables
#
# Copy to `.env` and fill in real values, or export them in your shell.
# `.env` files are git-ignored; `.env.example` is committed.

# --- Backend server -------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless you intentionally expose the demo on a LAN.
QUANTFISH_HOST=127.0.0.1
QUANTFISH_PORT=7860
# Runtime state (SQLite databases, submissions, reports, exports).
QUANTFISH_RUNTIME_ROOT=runs/web_platform
# Optional override for the config file path.
# QUANTFISH_CONFIG=config/platform.yaml

# --- Security -------------------------------------------------------------
# Admin console password. Required to open /api/admin/* endpoints.
QUANTFISH_ADMIN_PASSWORD=
# Session signing secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
QUANTFISH_ADMIN_SESSION_SECRET=
QUANTFISH_PARTICIPANT_SESSION_SECRET=

# --- Engine ---------------------------------------------------------------
# Overrides the auto-generated engine version (source hash by default).
# QUANTFISH_ENGINE_VERSION=dev

# --- Data release builder -------------------------------------------------
# Rows per parquet batch while materialising releases (large servers can raise it).
# QUANTFISH_RELEASE_PARQUET_BATCH_ROWS=200000

# --- Frontend -------------------------------------------------------------
# Comma separated list of origins allowed to call the API with credentials.
# QUANTFISH_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Static, backend-free demo build (GitHub Pages style).
# VITE_DEMO_MODE=true
# VITE_BASE_PATH=/
